{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.MailboxValidator/mcp-mailboxvalidator",
  "title": "MailboxValidator",
  "description": "Email validation MCP server using the MailboxValidator API. It can validate email addresses.",
  "repository": {
    "url": "https://github.com/MailboxValidator/mcp-mailboxvalidator",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "mcp-mailboxvalidator",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MAILBOXVALIDATOR_API_KEY",
          "description": "Your MailboxValidator API key.",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}